<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.landray</groupId>
    <artifactId>skill-hub</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>skill-hub</name>
    <description>团队内部 Agent Skill 分发平台</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 版本与 Spring Boot 主线一一对应:4.1.x 对 Boot 4.1,详见根 CLAUDE.md 踩坑点 8.3 -->
        <mybatis-starter.version>4.1.0</mybatis-starter.version>
        <!-- Spring Boot 4 不再管理 Testcontainers 版本(3.x 管),必须自己引 BOM -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <archunit.version>1.4.2</archunit.version>
        <spotless.version>3.9.0</spotless.version>
        <jacoco.version>0.8.15</jacoco.version>
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 只为容器 HEALTHCHECK 提供 /actuator/health:首页是静态文件,DB 挂了照样 200,探不出真问题。
             端点暴露白名单在 application.yml 里,只开 health。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-starter.version}</version>
        </dependency>

        <!-- 只为拿到工业级 BCrypt,不引整套 Spring Security(业务建模文档 3.1)。
             spring-boot-dependencies:4.1.0 导入了 spring-security-bom:7.1.0,声明时不写版本号;
             该 jar 编译期传递依赖为零(已用 mvn dependency:tree 核实)。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Spring Boot 4 把自动配置拆成了多个模块,光有 flyway-core 迁移不会跑,
             而且**不报任何错**,现象是应用正常启动、库里一张表都没有。
             详见根 CLAUDE.md 踩坑点 8.2。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10 起把各数据库支持拆成独立模块,PostgreSQL 必须显式引入 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI 3.1 文档生成 + swagger-ui。其 parent pom 就是
             spring-boot-starter-parent:4.1.0,版本与本项目锁定的 Spring Boot 主线一致(已用
             `curl .../springdoc-openapi/3.1.0/springdoc-openapi-3.1.0.pom` 核实,springdoc 2.x 是给
             Spring Boot 3 的,不能用,详见业务建模文档 8.1)。
             注意:它会把 Jackson 2 拖回 classpath,而且不止 databind ——
             swagger-core-jakarta:2.2.52 一次带进四个,全是 compile scope:
             jackson-databind / jackson-core / jackson-dataformat-yaml / jackson-datatype-jsr310。
             ArchUnit 的 mustNotUseJacksonTwoProcessingEngine 规则专门拦这个,
             实测依赖链与"为什么规则要全禁而不是列举子包"见该规则的注释。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 把测试自动配置也按功能拆开了,starter-test 不会因为主依赖里有 starter-web
             就自动带上 @WebMvcTest/MockMvc 支持,必须显式引入(与根 CLAUDE.md 踩坑点 8.2 同一套教训)。
             注意包名也变了:@WebMvcTest 现在在 org.springframework.boot.webmvc.test.autoconfigure 下,
             不是 3.x 的 org.springframework.boot.test.autoconfigure.web.servlet。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>${mybatis-starter.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 起真 PostgreSQL,不用 H2 冒充(方言差异会让测试骗人) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit 把分层规矩变成会失败的测试,不靠自觉 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <removeUnusedImports/>
                        <importOrder>
                            <order>java,javax,jakarta,org,com,</order>
                        </importOrder>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                        <indent>
                            <spaces>true</spaces>
                            <spacesPerTab>4</spacesPerTab>
                        </indent>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- 把依赖的实际路径暴露成属性(如 ${org.mockito:mockito-core:jar}),
                 下面 surefire 挂 Mockito agent 要用。绑在 initialize,保证跑在测试之前。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      JDK 21 起(JEP 451)对"运行时动态挂 Java agent"发告警,
                      并明确将来会**默认禁止**。Mockito 5 的 inline mock-maker 正是靠
                      byte-buddy-agent 自挂,实测会刷出:
                        Mockito is currently self-attaching to enable the inline-mock-maker.
                        WARNING: A Java agent has been loaded dynamically (byte-buddy-agent-*.jar)
                        WARNING: Dynamic loading of agents will be disallowed by default in a future release

                      这里**不用 -XX:+EnableDynamicAgentLoading** —— 那只是把告警藏起来,
                      等哪天升 JDK 会直接构建失败。按 Mockito 官方做法显式挂 agent,
                      mockito-core 的 MANIFEST 里有 Premain-Class,支持这么用。

                      -Xshare:off 消除随之而来的 CDS 告警
                      (Sharing is only supported for boot loader classes ...):
                      agent 往 bootstrap classpath 追加了内容,类数据共享随即失效。

                      @{argLine} 是必须的:JaCoCo 的 prepare-agent 把 -javaagent 写进
                      argLine 属性,而在 surefire 里显式配 <argLine> 会把它整个顶掉,
                      结果就是覆盖率永远 0。@{...} 让 Maven 在执行时把那份值原样嵌回来。
                    -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off @{argLine}</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- 启动类与 Spring 配置类无业务逻辑,测不到属正常 -->
                        <exclude>**/SkillHubApplication.class</exclude>
                        <exclude>**/infrastructure/config/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
