<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.landray</groupId>
    <artifactId>skill-hub</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>skill-hub</name>
    <description>团队内部 Agent Skill 分发平台</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 版本与 Spring Boot 主线一一对应:4.1.x 对 Boot 4.1,详见根 CLAUDE.md 踩坑点 8.3 -->
        <mybatis-starter.version>4.1.0</mybatis-starter.version>
        <!-- Spring Boot 4 不再管理 Testcontainers 版本(3.x 管),必须自己引 BOM -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <archunit.version>1.4.2</archunit.version>
        <!-- 对象存储走 S3 标准 API(domain.storage.ArtifactStorage 的类注释定的调子:不碰厂商特有接口)。
             阿里云 OSS 只是 endpoint 的一个取值,换 MinIO / RustFS 不动代码。
             **升级前必读**:2.30.0 起 SDK 默认给上传算 CRC32 校验和(aws-chunked trailer),OSS 不认,
             PutObject 会直接失败。S3ArtifactStorage 里用 requestChecksumCalculation(WHEN_REQUIRED)
             关掉了,别在不懂的情况下删那两行。 -->
        <aws-sdk.version>2.55.13</aws-sdk.version>
        <spotless.version>3.9.0</spotless.version>
        <jacoco.version>0.8.15</jacoco.version>
        <jacoco.line.minimum>0.80</jacoco.line.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 只为容器 HEALTHCHECK 提供 /actuator/health:首页是静态文件,DB 挂了照样 200,探不出真问题。
             端点暴露白名单在 application.yml 里,只开 health。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-starter.version}</version>
        </dependency>

        <!-- 只为拿到工业级 BCrypt,不引整套 Spring Security(业务建模文档 3.1)。
             spring-boot-dependencies:4.1.0 导入了 spring-security-bom:7.1.0,声明时不写版本号;
             该 jar 编译期传递依赖为零(已用 mvn dependency:tree 核实)。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- 解析 SKILL.md frontmatter(YAML)。不新增依赖——spring-boot-starter 自身编译期就传递依赖了
             org.yaml:snakeyaml:2.6(用于 Boot 自己加载 YAML 配置),已用 mvn dependency:tree 核实。这里改为
             显式声明,把"隐式享用别人拉进来的传递依赖"变成"有意识引入的直接依赖",版本仍交给
             spring-boot-dependencies 的依赖管理,不在本 pom 里另写版本号。 -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <!-- zip-slip/zip 炸弹防线需要读取 zip 条目的 Unix 外部文件属性来判定符号链接
             (业务建模文档 5.3 第 2 步"拒绝符号链接")。java.util.zip.ZipEntry **不暴露** external file
             attributes,这是 JDK 标准库的已知限制,没有绕开的公开 API;手写解析 ZIP 中央目录来读这 4 个字节
             属于"正是最容易写出安全 bug 的那类底层二进制解析",交给 commons-compress 这个久经考验的库更稳妥。
             写(重新打包)仍然用 java.util.zip.ZipOutputStream(stdlib),不用 commons-compress——
             业务建模文档 3.7 已经论证过 sha256 不追求可复现,没有必要为了写权限位换库;
             这里只在**读**这一侧引入它,职责单一。版本用当前 aliyun 镜像上的最新稳定版,显式锁定
             (该 artifact 不在 spring-boot-dependencies 的依赖管理范围内,必须自己写版本号)。 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>1.28.0</version>
        </dependency>

        <!-- Spring Boot 4 把自动配置拆成了多个模块,光有 flyway-core 迁移不会跑,
             而且**不报任何错**,现象是应用正常启动、库里一张表都没有。
             详见根 CLAUDE.md 踩坑点 8.2。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Flyway 10 起把各数据库支持拆成独立模块,PostgreSQL 必须显式引入 -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- OpenAPI 3.1 文档生成 + swagger-ui。其 parent pom 就是
             spring-boot-starter-parent:4.1.0,版本与本项目锁定的 Spring Boot 主线一致(已用
             `curl .../springdoc-openapi/3.1.0/springdoc-openapi-3.1.0.pom` 核实,springdoc 2.x 是给
             Spring Boot 3 的,不能用,详见业务建模文档 8.1)。
             注意:它会把 Jackson 2 拖回 classpath,而且不止 databind ——
             swagger-core-jakarta:2.2.52 一次带进四个,全是 compile scope:
             jackson-databind / jackson-core / jackson-dataformat-yaml / jackson-datatype-jsr310。
             ArchUnit 的 mustNotUseJacksonTwoProcessingEngine 规则专门拦这个,
             实测依赖链与"为什么规则要全禁而不是列举子包"见该规则的注释。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- S3 客户端。只取 s3 这一个 artifact,不引 bom:当前只用到同步 S3Client,
             多引一个 bom 等于给将来留下"顺手 import 别的 AWS 服务"的口子。
             它自带的 JSON 处理是 shade 过的(software.amazon.awssdk.thirdparty.jackson..),
             不会触发 ArchUnit 的 mustNotUseJacksonTwoProcessingEngine 规则。 -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws-sdk.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Spring Boot 4 把测试自动配置也按功能拆开了,starter-test 不会因为主依赖里有 starter-web
             就自动带上 @WebMvcTest/MockMvc 支持,必须显式引入(与根 CLAUDE.md 踩坑点 8.2 同一套教训)。
             注意包名也变了:@WebMvcTest 现在在 org.springframework.boot.webmvc.test.autoconfigure 下,
             不是 3.x 的 org.springframework.boot.test.autoconfigure.web.servlet。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter-test</artifactId>
            <version>${mybatis-starter.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers 起真 PostgreSQL,不用 H2 冒充(方言差异会让测试骗人) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- ArchUnit 把分层规矩变成会失败的测试,不靠自觉 -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <removeUnusedImports/>
                        <importOrder>
                            <order>java,javax,jakarta,org,com,</order>
                        </importOrder>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                        <indent>
                            <spaces>true</spaces>
                            <spacesPerTab>4</spacesPerTab>
                        </indent>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>validate</phase>
                    </execution>
                </executions>
            </plugin>

            <!-- 把依赖的实际路径暴露成属性(如 ${org.mockito:mockito-core:jar}),
                 下面 surefire 挂 Mockito agent 要用。绑在 initialize,保证跑在测试之前。 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>resolve-agent-paths</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!--
                      JDK 21 起(JEP 451)对"运行时动态挂 Java agent"发告警,
                      并明确将来会**默认禁止**。Mockito 5 的 inline mock-maker 正是靠
                      byte-buddy-agent 自挂,实测会刷出:
                        Mockito is currently self-attaching to enable the inline-mock-maker.
                        WARNING: A Java agent has been loaded dynamically (byte-buddy-agent-*.jar)
                        WARNING: Dynamic loading of agents will be disallowed by default in a future release

                      这里**不用 -XX:+EnableDynamicAgentLoading** —— 那只是把告警藏起来,
                      等哪天升 JDK 会直接构建失败。按 Mockito 官方做法显式挂 agent,
                      mockito-core 的 MANIFEST 里有 Premain-Class,支持这么用。

                      -Xshare:off 消除随之而来的 CDS 告警
                      (Sharing is only supported for boot loader classes ...):
                      agent 往 bootstrap classpath 追加了内容,类数据共享随即失效。

                      @{argLine} 是必须的:JaCoCo 的 prepare-agent 把 -javaagent 写进
                      argLine 属性,而在 surefire 里显式配 <argLine> 会把它整个顶掉,
                      结果就是覆盖率永远 0。@{...} 让 Maven 在执行时把那份值原样嵌回来。
                    -->
                    <argLine>-javaagent:${org.mockito:mockito-core:jar} -Xshare:off @{argLine}</argLine>
                    <!--
                      测试一律用本地文件夹实现 ArtifactStorage,不碰对象存储。

                      起因:项目所有 @SpringBootTest 都跑 dev profile(application.yml 里 active 默认 dev),
                      而 dev 现在走阿里云 OSS。不钉这一条,每个集成测试都要先有一对真 AK 才能启动 ——
                      测试不该依赖外网、不该依赖一对会过期的凭证、更不该往真桶里写垃圾。

                      为什么钉成系统属性而不是逐个测试加 @TestPropertySource:
                      Java 系统属性的优先级高于 application-*.yml,在这里钉一次就覆盖全部测试;
                      逐个加一定会漏 —— 新写的集成测试没人会记得补那一行,而漏掉的表现是
                      "本机跑得过、换台机器起不来",排查成本极高。

                      真正验证 S3 实现的 S3ArtifactStorageTest 不走 Spring 容器、自己 new,不受这条影响。
                    -->
                    <systemPropertyVariables>
                        <skillhub.storage.type>local</skillhub.storage.type>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <excludes>
                        <!-- 启动类与 Spring 配置类无业务逻辑,测不到属正常 -->
                        <exclude>**/SkillHubApplication.class</exclude>
                        <exclude>**/infrastructure/config/**</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.line.minimum}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
