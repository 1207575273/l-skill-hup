# docker compose 会自动读取 docker/.env(与 docker-compose.yml 同目录)。
#
#   cp docker/.env.example docker/.env
#
# dev:整份保持默认即可,只起 postgres。
# prod:**必须**改掉 DB_PASSWORD,其余按服务器情况调。
# .env 已被 .gitignore 忽略,不会入库。

# ---- 数据库 ----
DB_NAME=skillhub
DB_USER=skillhub
# [PROD 必改] 默认值只为本机开箱即用
DB_PASSWORD=skillhub
# 宿主机映射端口。15432 是为了避开 WSL 里其他项目的 5432,一般不用改。
DB_PORT_HOST=15432

# ---- 应用 ----
APP_PORT=18080
APP_VERSION=0.1.0
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/app/logs

# ---- 构建镜像源 ----
# 内网 / 国内默认走镜像站。要走官方源就置空或改成官方地址:
#   NPM_REGISTRY=https://registry.npmjs.org
#   MAVEN_MIRROR_URL=
NPM_REGISTRY=https://registry.npmmirror.com
MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
